{
  "openapi": "3.1.0",
  "info": {
    "title": "WFO Search Agent",
    "version": "0.1.0"
  },
  "paths": {
    "/health/": {
      "get": {
        "tags": ["Health"],
        "summary": "Get Health",
        "description": "Health check \u2014 verifies database connectivity.",
        "operationId": "get_health_health__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/agui/": {
      "post": {
        "tags": ["AG-UI"],
        "summary": "Agent Conversation",
        "description": "Agent conversation endpoint using pydantic-ai AG-UI protocol.",
        "operationId": "agent_conversation_agui__post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/chats/": {
      "get": {
        "tags": ["AG-UI"],
        "summary": "List Chats",
        "description": "The caller's chats, newest first.",
        "operationId": "list_chats_chats__get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChatSummary"
                  },
                  "title": "Response List Chats Chats  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/chats/{thread_id}": {
      "get": {
        "tags": ["AG-UI"],
        "summary": "Get Chat",
        "description": "One chat: its last ``last`` messages and the form stop it waits on, if any.",
        "operationId": "get_chat_chats__thread_id__get",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Thread Id"
            }
          },
          {
            "name": "last",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Last"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chat"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["AG-UI"],
        "summary": "Forget Chat",
        "description": "Forget a chat: its messages, its state and its open form.",
        "operationId": "forget_chat_chats__thread_id__delete",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Thread Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/chats/{thread_id}/exports/{query_id}": {
      "get": {
        "tags": ["AG-UI"],
        "summary": "Download Export",
        "description": "An export the chat prepared: core's CSV file for the query, fetched as the person asking and passed on.\n\nThe export's ``download_url`` in the chat points here. Core's own export endpoint is behind the person's\ntoken, on another origin than the page: this route forwards the token and hands core's answer on as it\ncame, the file with its content type and name. Only an export this chat prepared is served, so a query id\npicked up elsewhere does not open another person's results.",
        "operationId": "download_export_chats__thread_id__exports__query_id__get",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Thread Id"
            }
          },
          {
            "name": "query_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Query Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Chat": {
        "properties": {
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "form_open": {
            "type": "boolean",
            "title": "Form Open"
          },
          "messages": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Messages"
          },
          "pending": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pending"
          }
        },
        "type": "object",
        "required": ["thread_id", "title", "updated_at", "form_open", "messages", "pending"],
        "title": "Chat",
        "description": "A chat as it is opened (``GET /chats/{id}``): its last messages, and the form stop to show again."
      },
      "ChatSummary": {
        "properties": {
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "form_open": {
            "type": "boolean",
            "title": "Form Open"
          }
        },
        "type": "object",
        "required": ["thread_id", "title", "updated_at", "form_open"],
        "title": "ChatSummary",
        "description": "A chat as the list shows it (``GET /chats/``)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      },
      "ApprovalAnswer": {
        "description": "The payload that resolves the interrupt: the decision on the start, as AG-UI shapes an approval.\n\nA rejection may say why, or what to change: the model reads it and acts on it.",
        "properties": {
          "approved": {
            "title": "Approved",
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reason"
          }
        },
        "required": ["approved"],
        "title": "ApprovalAnswer",
        "type": "object"
      },
      "ApprovalStop": {
        "description": "The start of a workflow as the person approves it: what a client shows on the approval.\n\n``values`` are what the accepted pages hold, each as the form shows it (an id is not something a person\ncan confirm); ``defaults`` the optional fields nobody gave a value; ``summary`` the tables of the\nworkflow's own summary page, when its form ends in one.",
        "properties": {
          "workflow_key": {
            "title": "Workflow Key",
            "type": "string"
          },
          "values": {
            "additionalProperties": true,
            "title": "Values",
            "type": "object"
          },
          "defaults": {
            "additionalProperties": true,
            "title": "Defaults",
            "type": "object"
          },
          "summary": {
            "items": {
              "$ref": "#/components/schemas/SummaryTable"
            },
            "title": "Summary",
            "type": "array"
          }
        },
        "required": ["workflow_key"],
        "title": "ApprovalStop",
        "type": "object"
      },
      "ChartData": {
        "description": "A grouped aggregation as data a client draws itself (the popup), beside its Mermaid rendering.\n\n``kind`` is core's ``visualization`` hint (pie, bar or line); ``metric`` names the aggregation plotted\nand ``title`` says what it is grouped by. A pie is a part-to-whole hint, which a client is free to\ndraw as bars.",
        "properties": {
          "kind": {
            "enum": ["pie", "bar", "line"],
            "title": "Kind",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "metric": {
            "title": "Metric",
            "type": "string"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/ChartPoint"
            },
            "title": "Points",
            "type": "array"
          }
        },
        "required": ["kind", "title", "metric", "points"],
        "title": "ChartData",
        "type": "object"
      },
      "ChartPoint": {
        "description": "One category of a distribution and the value plotted for it.",
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Value"
          }
        },
        "required": ["label", "value"],
        "title": "ChartPoint",
        "type": "object"
      },
      "DataArtifact": {
        "description": "Metadata for tools that return full entity data for LLM reasoning.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "entity_id": {
            "title": "Entity Id",
            "type": "string"
          },
          "entity_type": {
            "title": "Entity Type",
            "type": "string"
          }
        },
        "required": ["description", "entity_id", "entity_type"],
        "title": "DataArtifact",
        "type": "object"
      },
      "ExportArtifact": {
        "description": "Metadata for tools that produce a downloadable export reference.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "query_id": {
            "title": "Query Id",
            "type": "string"
          },
          "download_url": {
            "description": "Where the export is downloaded. On the AG-UI route it is relative to the chat: ``exports/{query_id}`` under ``GET /chats/{thread_id}/`` serves the rows as a CSV file, as the person asking.",
            "title": "Download Url",
            "type": "string"
          }
        },
        "required": ["description", "query_id", "download_url"],
        "title": "ExportArtifact",
        "type": "object"
      },
      "FormActivity": {
        "description": "The content of a ``workflow_form`` activity message: where a workflow form stands.",
        "properties": {
          "workflow_key": {
            "title": "Workflow Key",
            "type": "string"
          },
          "phase": {
            "$ref": "#/components/schemas/FormPhase"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Page"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Title"
          },
          "values": {
            "additionalProperties": true,
            "default": {},
            "title": "Values",
            "type": "object"
          },
          "calls": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Calls",
            "type": "array"
          }
        },
        "required": ["workflow_key", "phase"],
        "title": "FormActivity",
        "type": "object"
      },
      "FormPhase": {
        "description": "Where a form stands; the strings are the session's ``status`` as persisted.",
        "enum": ["gathering", "confirming", "done"],
        "title": "FormPhase",
        "type": "string"
      },
      "QueryArtifact": {
        "description": "Lightweight reference returned by query tools.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "query_id": {
            "title": "Query Id",
            "type": "string"
          },
          "total_results": {
            "title": "Total Results",
            "type": "integer"
          },
          "visualization_type": {
            "$ref": "#/components/schemas/VisualizationType"
          },
          "search_type": {
            "default": "",
            "title": "Search Type",
            "type": "string"
          },
          "rendered_block": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RenderedBlock"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "chart": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChartData"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": ["description", "query_id", "total_results"],
        "title": "QueryArtifact",
        "type": "object"
      },
      "RenderedBlock": {
        "description": "A pre-rendered output block ready to inject into the agent's text reply.",
        "properties": {
          "type": {
            "enum": ["mermaid", "markdown"],
            "title": "Type",
            "type": "string"
          },
          "content": {
            "title": "Content",
            "type": "string"
          }
        },
        "required": ["type", "content"],
        "title": "RenderedBlock",
        "type": "object"
      },
      "SummaryTable": {
        "description": "One table of a workflow's own summary page, as pydantic-forms carries it (the shape of its ``SummaryData``).\n\nA row per label and a column per item compared (before and after, for a modify), headed when the form\nheads them.",
        "properties": {
          "headers": {
            "items": {
              "type": "string"
            },
            "title": "Headers",
            "type": "array"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "title": "Labels",
            "type": "array"
          },
          "columns": {
            "items": {
              "items": {},
              "type": "array"
            },
            "title": "Columns",
            "type": "array"
          }
        },
        "title": "SummaryTable",
        "type": "object"
      },
      "VisualizationType": {
        "description": "Visualization type for aggregation results.\n\nChoose based on the query context:\n- 'pie': For categorical distributions (e.g., subscriptions by status, products by type)\n- 'line': For time-series data (e.g., subscriptions created per month, trends over time)\n- 'table': For detailed data or multiple grouping dimensions (default)",
        "properties": {
          "type": {
            "default": "table",
            "description": "Visualization render type: 'pie' for categorical distributions, 'line' for time-series, 'table' for detailed data",
            "enum": ["pie", "line", "table"],
            "title": "Type",
            "type": "string"
          }
        },
        "title": "VisualizationType",
        "type": "object"
      }
    }
  }
}
